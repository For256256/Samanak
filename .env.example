# توکن ربات از @BotFather
BOT_TOKEN=

# ادمین کل: تایید هر دو شهر + گزارش و خروجی (چند نفر را با کاما جدا کنید)
SUPER_ADMIN_IDS=

# ادمین شهرها: فقط رزروهای همان شهر را می‌بینند و تایید می‌کنند
ADMIN_NAJAF_IDS=
ADMIN_KARBALA_IDS=

# اختیاری: گروه اختصاصی هر شهر (عدد منفی). اگر پر شود، به‌جای پی‌وی ادمین شهر آنجا ارسال می‌شود
ADMIN_CHAT_NAJAF=
ADMIN_CHAT_KARBALA=

DB_PATH=./data/bot.db
DOCS_DIR=./data/docs

# داشبورد ادمین وب
PANEL_PORT=8080
PANEL_HOST=0.0.0.0
PANEL_USER=admin
PANEL_PASSWORD=
PANEL_SECRET=

# اختیاری: آدرس سرور Bot API (برای Bot API محلی یا پروکسی). خالی = سرور رسمی تلگرام
TELEGRAM_API_ROOT=

# قوانین رزرو
MAX_NIGHTS=7
MAX_DAYS_AHEAD=120
MAX_PER_BOOKING=10

# ظرفیت شبانه به تفکیک جنسیت
CAP_NAJAF_MEN=40
CAP_NAJAF_WOMEN=40
CAP_KARBALA_MEN=40
CAP_KARBALA_WOMEN=40

# نکته: از این پس شهرها، اقامتگاه‌ها، ادمین‌ها و سقف‌ها در دیتابیس
# نگهداری می‌شوند و از داشبورد قابل ویرایش‌اند. مقادیر بالا فقط در
# اولین اجرا برای مقداردهی اولیه خوانده می‌شوند.
