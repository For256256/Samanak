[Unit]
Description=Bayt al-Hussein Telegram reservation bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bhbot
WorkingDirectory=/opt/bh-bot
EnvironmentFile=/opt/bh-bot/.env
ExecStart=/usr/bin/node /opt/bh-bot/src/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# سخت‌گیری امنیتی
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/bh-bot/data

[Install]
WantedBy=multi-user.target
